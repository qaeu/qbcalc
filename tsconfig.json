{
	"compilerOptions": {
		// General
		"jsx": "preserve",
		"jsxImportSource": "solid-js",
		"target": "ESNext",

		// Modules
		"allowSyntheticDefaultImports": true,
		"esModuleInterop": true,
		"isolatedModules": true,
		"module": "ESNext",
		"moduleResolution": "bundler",
		"noEmit": true,
		"paths": {
			"#c/*": ["./src/components/*"],
			"#styles/*": ["./src/styles/*.scss"],
			"#*": ["./src/*"]
		},

		// Type Checking & Safety
		// Node's globals aren't installed (nothing here is typed against them),
		// so vitest's own declarations don't resolve. Their errors are noise.
		"skipLibCheck": true,
		"strict": true,
		"types": ["vite/client", "vitest/globals"]
	}
}
