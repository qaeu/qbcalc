		"@vitest/ui": "^5.0.0",
		"eslint": "^9.38.0",
		"eslint-plugin-solid": "^0.14.5",
		"globals": "^16.4.0",
		"jsdom": "^27.0.1",
		"playwright": "^1.62.1",
		"prettier": "^3.6.2",
		"sass": "^1.93.2",
		"tsx": "^4.23.13",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.46.2",
